[["قُلۡ أَعُوذُ بِرَبِّ ٱلنَّاسِ","Say, \"I seek refuge in the Lord of mankind","Qul aAAoothu birabbi alnnasi"],["مَلِكِ ٱلنَّاسِ","The Sovereign of mankind","Maliki alnnasi"],["إِلَٰهِ ٱلنَّاسِ","The God of mankind","Ilahi alnnasi"],["مِن شَرِّ ٱلۡوَسۡوَاسِ ٱلۡخَنَّاسِ","From the evil of the retreating whisperer","Min sharri alwaswasi alkhannasi"],["ٱلَّذِي يُوَسۡوِسُ فِي صُدُورِ ٱلنَّاسِ","Who whispers [evil] into the breasts of mankind","Allathee yuwaswisu fee sudoori alnnasi"],["مِنَ ٱلۡجِنَّةِ وَٱلنَّاسِ","From among the jinn and mankind","Mina aljinnati wa alnnasm"]]
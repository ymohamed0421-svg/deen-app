[["أَلۡهَىٰكُمُ ٱلتَّكَاثُرُ","Competition in [worldly] increase diverts you","Alhakumu alttakathuru"],["حَتَّىٰ زُرۡتُمُ ٱلۡمَقَابِرَ","Until you visit the graveyards","Hatta zurtumu almaqabira"],["كَلَّا سَوۡفَ تَعۡلَمُونَ","No! You are going to know","Kalla sawfa taAAlamoona"],["ثُمَّ كَلَّا سَوۡفَ تَعۡلَمُونَ","Then no! You are going to know","Thumma kalla sawfa taAAlamoona"],["كَلَّا لَوۡ تَعۡلَمُونَ عِلۡمَ ٱلۡيَقِينِ","No! If you only knew with knowledge of certainty","Kalla law taAAlamoona AAilma alyaqeeni"],["لَتَرَوُنَّ ٱلۡجَحِيمَ","You will surely see the Hellfire","Latarawunna aljaheema"],["ثُمَّ لَتَرَوُنَّهَا عَيۡنَ ٱلۡيَقِينِ","Then you will surely see it with the eye of certainty","Thumma latarawunnaha AAayna alyaqeeni"],["ثُمَّ لَتُسۡـَٔلُنَّ يَوۡمَئِذٍ عَنِ ٱلنَّعِيمِ","Then you will surely be asked that Day about pleasure","Thumma latusalunna yawmaithin AAani alnnaAAeemi"]]